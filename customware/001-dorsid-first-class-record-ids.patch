+++ b/language-tests/tests/language/statements/define/table/id_generation.surql
@@ -0,0 +1,118 @@
+/**
+[test]
+reason = """
+End-to-end coverage for the fork's `DEFINE TABLE ... ID DEFAULT|SID|RID` clause
+(customware/001). Until this file existed the feature had only a parser
+round-trip unit test and no behavioural coverage at all, while the dispatch
+underneath it was rewritten twice: once when upstream 3.2 introduced the
+id-field DEFAULT path and `coerce_id_key`, and once when the policy moved to a
+fork-owned sidecar key (customware/005).
+
+Sid and Rid values are time- and entropy-dependent, so nothing here asserts a
+literal id. Every check is a boolean.
+"""
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "'SID'"
+
+[[test.results]]
+value = "'RID'"
+
+[[test.results]]
+value = "NONE"
+
+*/
+
+-- One table per policy, plus the implicit (no clause) case.
+DEFINE TABLE sid_tb ID SID;
+DEFINE TABLE rid_tb ID RID;
+DEFINE TABLE default_tb ID DEFAULT;
+DEFINE TABLE implicit_tb;
+
+-- `ID SID` mints integer keys that strictly increase.
+LET $a = (CREATE ONLY sid_tb RETURN VALUE id);
+LET $b = (CREATE ONLY sid_tb RETURN VALUE id);
+type::is_number(record::id($a));
+record::id($b) > record::id($a);
+
+-- `ID RID` mints integer keys.
+LET $r = (CREATE ONLY rid_tb RETURN VALUE id);
+type::is_number(record::id($r));
+
+-- `ID DEFAULT` and the implicit form both keep upstream's random string key.
+LET $d = (CREATE ONLY default_tb RETURN VALUE id);
+type::is_string(record::id($d)) AND string::len(record::id($d)) == 20;
+
+LET $i = (CREATE ONLY implicit_tb RETURN VALUE id);
+type::is_string(record::id($i)) AND string::len(record::id($i)) == 20;
+
+-- The DDL round-trips the clause, and omits it for the default policy so that
+-- non-Dorsid tables render exactly as upstream renders them.
+LET $tables = (INFO FOR DB).tables;
+string::contains($tables.sid_tb, "ID SID");
+string::contains($tables.rid_tb, "ID RID");
+!string::contains($tables.default_tb, " ID ") AND !string::contains($tables.implicit_tb, " ID ");
+
+-- INFO ... STRUCTURE surfaces the policy only for the tables that use it; a
+-- default-policy table carries no `id_generation` key at all.
+LET $structured = (INFO FOR DB STRUCTURE).tables;
+$structured[WHERE name = "sid_tb"][0].id_generation;
+$structured[WHERE name = "rid_tb"][0].id_generation;
+$structured[WHERE name = "default_tb"][0].id_generation;
diff --git a/language-tests/tests/language/statements/define/table/id_generation_lifecycle.surql b/language-tests/tests/language/statements/define/table/id_generation_lifecycle.surql
new file mode 100644
index 000000000..92eb41390
--- /dev/null
+++ b/language-tests/tests/language/statements/define/table/id_generation_lifecycle.surql
@@ -0,0 +1,85 @@
+/**
+[test]
+reason = """
+Lifecycle and precedence rules for the fork's `ID SID` / `ID RID` policy
+(customware/001, sidecar storage from customware/005).
+
+The policy lives in its own `!ig` key under the table root rather than on
+`TableDefinition`, so its lifecycle is not automatic — this pins the cases where
+it must be reset, plus the precedence rule that an `id` field `DEFAULT` wins
+over the table's policy.
+
+The opposite interaction — an `id` kind that cannot hold a Sid — is rejected at
+definition time and is covered by
+`language/statements/alter/alter_table_id_generation.surql`.
+"""
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "true"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "NONE"
+
+[[test.results]]
+value = "'pinned'"
+
+*/
+
+-- DEFINE TABLE OVERWRITE without an `ID` clause resets the policy to default.
+DEFINE TABLE reset_tb ID SID;
+LET $sid_id = (CREATE ONLY reset_tb RETURN VALUE id);
+type::is_number(record::id($sid_id));
+DEFINE TABLE OVERWRITE reset_tb;
+LET $after_overwrite = (CREATE ONLY reset_tb RETURN VALUE id);
+type::is_string(record::id($after_overwrite));
+
+-- REMOVE TABLE drops the policy with the rest of the table prefix, so a table
+-- redefined under the same name starts from the default again.
+DEFINE TABLE removed_tb ID RID;
+REMOVE TABLE removed_tb;
+DEFINE TABLE removed_tb;
+LET $after_remove = (CREATE ONLY removed_tb RETURN VALUE id);
+type::is_string(record::id($after_remove));
+
+-- An `id` field `DEFAULT` is evaluated before the table's `IdGeneration`
+-- policy, so it silently wins over `ID SID`. Field-level beats table-level.
+DEFINE TABLE default_wins ID SID SCHEMAFULL;
+DEFINE FIELD id ON default_wins TYPE string DEFAULT "pinned";
+LET $defaulted = (CREATE ONLY default_wins RETURN VALUE id);
+record::id($defaulted);
